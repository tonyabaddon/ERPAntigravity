{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run src",
    "test:integration": "vitest run --no-file-parallelism tests/integration",
    "test:isolation": "vitest run --dir tests/isolation --no-coverage",
    "audit:views": "tsx scripts/audit-view-security-invoker.ts",
    "audit:numinput": "! grep -rnE '(^|[^a-zA-Z_])Number\\(e\\.target\\.value\\)' src --include='*.tsx' --include='*.ts' | grep -v -E '(NumberInput\\.tsx|\\.test\\.)' | grep .",
    "audit:secdef-null-tenant": "tsx scripts/audit-secdef-null-tenant.ts",
    "audit:csp-backend-allowlist": "tsx scripts/audit-csp-backend-allowlist.ts",
    "audit:no-string-err-fallback": "tsx scripts/audit-no-string-err-fallback.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@google/genai": "^2.4.0",
    "@sentry/react": "^9.47.1",
    "@supabase/supabase-js": "^2.106.2",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-query": "^5.101.4",
    "@vitejs/plugin-react": "^5.0.4",
    "express": "^4.21.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.20.0",
    "autoprefixer": "^10.4.21",
    "dotenv": "^17.4.2",
